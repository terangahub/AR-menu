// Vorae - schéma de données (cahier des charges v2.0, section 8)
// Base : Neon PostgreSQL serverless (DATABASE_URL en variable d'environnement)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  logoUrl            String?
  primaryColor       String?
  city               String   @default("Montréal")
  email              String
  defaultLocale      String   @default("fr")
  stripeCustomerId   String?
  whiteLabelParentId String?
  createdAt          DateTime @default(now())

  users         User[]
  dishes        Dish[]
  qrCodes       QrCode[]
  subscription  Subscription?
  captureOrders DishCaptureOrder[]
  notes         SuperAdminNote[]
}

model User {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  email        String     @unique
  // Lie l'identité Clerk (authentification) à ce profil restaurant - non
  // présent dans le modèle de la section 8, nécessaire pour le dashboard
  // (section 10, 18). Nullable : un profil peut être créé avant la première
  // connexion (invitation d'équipe, section 10.7).
  clerkUserId  String?    @unique
  role         String     @default("owner") // owner | staff | superadmin
  createdAt    DateTime   @default(now())
}

model Dish {
  id              String         @id @default(cuid())
  restaurantId    String
  restaurant      Restaurant     @relation(fields: [restaurantId], references: [id])
  name            String
  nameEn          String?
  description     String?
  descriptionEn   String?
  // category, ingredients, prepTimeMinutes : référencés par F02/F05
  // (catégorie, fiche plat) mais absents du modèle de données de la
  // section 8 - ajoutés pour compléter le schéma. Variantes *En pour le
  // bilingue FR/EN complet (F06) - description/ingrédients/catégorie
  // n'avaient pas d'équivalent anglais, contrairement à name/nameEn.
  category        String?
  categoryEn      String?
  ingredients     String?
  ingredientsEn   String?
  prepTimeMinutes Int?
  price           Decimal
  imageUrl        String?
  model3dGlbUrl   String?
  model3dUsdzUrl  String?
  isArReady       Boolean        @default(false)
  isAvailable     Boolean        @default(true)
  allergens       DishAllergen[]
  scans           ScanEvent[]
  scanJobs        ScanJob[]
  createdAt       DateTime       @default(now())
}

// Table d'allergènes de référence (partagée entre tous les restaurants),
// reliée aux plats via la table de jointure DishAllergen (section 8 y fait
// référence sans la définir explicitement).
model Allergen {
  id     String         @id @default(cuid())
  code   String         @unique // ex: "gluten", "peanuts", "shellfish"
  nameFr String
  nameEn String
  dishes DishAllergen[]
}

model DishAllergen {
  dishId     String
  dish       Dish     @relation(fields: [dishId], references: [id])
  allergenId String
  allergen   Allergen @relation(fields: [allergenId], references: [id])

  @@id([dishId, allergenId])
}

model QrCode {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id])
  tableNumber  String?
  targetUrl    String
  scansCount   Int         @default(0)
  scans        ScanEvent[]
}

model ScanEvent {
  id          String   @id @default(cuid())
  qrCodeId    String
  qrCode      QrCode   @relation(fields: [qrCodeId], references: [id])
  dishId      String?
  dish        Dish?    @relation(fields: [dishId], references: [id])
  arActivated Boolean  @default(false)
  deviceType  String?
  timestamp   DateTime @default(now())
}

// --- Facturation & abonnements ---

model Subscription {
  id                   String     @id @default(cuid())
  restaurantId         String     @unique
  restaurant           Restaurant @relation(fields: [restaurantId], references: [id])
  tier                 String // essentiel | croissance | prestige
  billingCycle         String // monthly | annual
  status               String // trialing | active | past_due | canceled
  includedDishSlots    Int
  extraDishCount       Int        @default(0)
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime   @default(now())
}

model Invoice {
  id              String   @id @default(cuid())
  restaurantId    String
  stripeInvoiceId String
  amount          Decimal
  status          String // paid | open | failed
  pdfUrl          String?
  issuedAt        DateTime @default(now())
}

model DishCaptureOrder {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  dishCount     Int
  packageType   String // a_la_carte | forfait_demarrage | forfait_menu_complet | recapture
  amount        Decimal
  status        String // scheduled | in_progress | delivered
  scheduledDate DateTime?
  completedAt   DateTime?
}

// Scan 3D automatise (Sprint 4.7, docs/roadmap-ai-instant-3d.md section 0)
// - self-service, complementaire a DishCaptureOrder (service humain de la
// section 15.3, plus cher, plus lent, sans limite de rapport de forme).
// externalJobId = "serialize" cote KIRI, l'identifiant qui permet de
// retrouver ce job depuis un webhook recu (un seul callback pour tous les
// jobs du compte, cf. la doc officielle).
model ScanJob {
  id              String    @id @default(cuid())
  dishId          String
  dish            Dish      @relation(fields: [dishId], references: [id])
  provider        String // "kiri" | "realityscan" (plan B, non implemente)
  algorithm       String // "photo" | "featureless" | "3dgs"
  status          String // uploading | processing | queuing | successful | failed | expired
  externalJobId   String? // "serialize" cote KIRI, absent si l'appel initial a echoue
  sourceMediaType String // "video" | "image"
  // URL Cloudinary temporaire du média source (upload direct client, ne
  // transite jamais par la Function - voir CONTEXT.md section 5). Pour
  // un scan photo, seule la première URL est gardée ici, à titre de
  // traçabilité, pas la liste complète.
  sourceMediaUrl  String?
  // Format demande a l'appel : fileFormat de l'API KIRI n'accepte qu'une
  // seule valeur par appel (pas une liste) - voir la mise en garde en
  // section 0 du document de roadmap sur le doute glb+usdz en un seul
  // appel ou deux.
  requestedFormat String // "glb" | "usdz"
  resultModelUrl  String? // lien getModelZip, valable 60 minutes seulement
  resultGlbUrl    String? // apres televersement Cloudinary (permanent)
  resultUsdzUrl   String?
  creditsUsed     Int? // 1 par appel reussi, cf. tarif confirme (1 $/credit)
  errorCode       Int? // code detaille KIRI (2000-2010), pas juste le statut HTTP
  errorMessage    String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
}

model SuperAdminNote {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  authorId     String
  content      String
  createdAt    DateTime   @default(now())
}

DATABASE_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel Blob stocke les modèles 3D issus du scan (Sprint 7) : Cloudinary
# refuse tout fichier `raw` au-delà de 10 Mo de taille totale, bien en-deçà
# d'un modèle KIRI réel (80-90 Mo). Voir lib/blob-storage.ts et CONTEXT.md
# section 5.
#
# Rien à remplir ici pour le déploiement Vercel : connecter un store Blob
# au projet (Storage > Create Database > Blob > Connect to Project, sur
# les environnements Preview et Production) authentifie automatiquement
# via OIDC (BLOB_STORE_ID + VERCEL_OIDC_TOKEN, injectées par Vercel).
# Choisir un store de type **public** à la création : ce choix ne peut
# plus changer ensuite, et les modèles doivent être accessibles par une
# simple URL pour le visualiseur AR côté navigateur.
#
# BLOB_READ_WRITE_TOKEN n'est qu'un repli, nécessaire seulement pour du
# code qui tourne hors de Vercel (ce n'est pas notre cas) ou pour du
# développement local sans `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ESSENTIEL_MONTHLY=
STRIPE_PRICE_ESSENTIEL_ANNUAL=
STRIPE_PRICE_CROISSANCE_MONTHLY=
STRIPE_PRICE_CROISSANCE_ANNUAL=
STRIPE_PRICE_PRESTIGE_MONTHLY=
STRIPE_PRICE_PRESTIGE_ANNUAL=

RESEND_API_KEY=

KIRI_ENGINE_API_KEY=
KIRI_WEBHOOK_SECRET=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Domaine public de l'application, sans barre finale (ex : https://vorae.app).
# Laissé vide, l'application retombe sur les variables fournies par Vercel :
# l'alias stable du domaine de production en production, l'URL du
# déploiement courant en preview.
#
# À renseigner dès qu'un vrai domaine existe : c'est cette valeur qui est
# gravée dans les QR codes imprimés, et un carton déjà collé sur une table
# ne peut plus être corrigé à distance.
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DEFAULT_LOCALE=fr
